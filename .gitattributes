# Authoring happens on Windows; everything here executes on Linux (the robot's
# Jetson). CRLF in a shell script makes bash fail with `$'\r': command not found`,
# so force LF on everything that runs or gets parsed on the robot.

* text=auto eol=lf

*.sh      text eol=lf
*.bash    text eol=lf
*.py      text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.json    text eol=lf
*.xml     text eol=lf
*.urdf    text eol=lf
*.xacro   text eol=lf
*.launch  text eol=lf
*.cpp     text eol=lf
*.hpp     text eol=lf
*.c       text eol=lf
*.h       text eol=lf
*.md      text eol=lf
*.csv     text eol=lf
CMakeLists.txt text eol=lf
Dockerfile*    text eol=lf

# Windows-only helpers keep CRLF
*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Binary — never touch
*.pcd     binary
*.ply     binary
*.bag     binary
*.db3     binary
*.mcap    binary
*.pgm     binary
*.png     binary
*.jpg     binary
